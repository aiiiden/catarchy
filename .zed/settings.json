{
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      },
      "prettier": {
        "allowed": false
      },
      "language_servers": ["oxlint", "..."],
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      }
    },
