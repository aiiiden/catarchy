{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "cSpell.words": ["Elysia", "catarchy"],
  "files.associations": {
    "*.jsonc": "jsonc",
    "**/*.module.css": "css"
  },
  "search.exclude": {
    "**/.wrangler": true,
    "**/.localflare": true
  }
}
